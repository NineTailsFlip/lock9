<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lock is signed with the platform key and installed as a privileged, persistent app (the
         thor2 image: android_vendor_thor2's apps/), so it holds what it declares below; the
         privileged ones are also in the image's privapp-permissions-nine-lock.xml. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- The PIN check (LockSettingsService), and sending SystemUI the unlock (patch 0006). -->
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
    <!-- Reporting attempts as the bouncer does: device admins and trust agents. -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />
    <!-- Hearing the keyguard lock and unlock. -->
    <uses-permission android:name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE" />
    <!-- Putting the lock screen up from the background when the phone locks. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <!-- Its own notification access; media sessions for the music row. -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The carrier line, and the SIM PIN and PUK. -->
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <!-- Back turns the screen off. -->
    <uses-permission android:name="android.permission.DEVICE_POWER" />

    <!-- :update is only here for SetupChoices: Lock is part of the image and is updated with it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application
        android:name=".LockApp"
        android:label="Lock"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.Nine"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true">

        <!-- Over the keyguard, in a task of its own, never in Recents. The system and SystemUI
             start it in place of the stock keyguard (org.thor2.keyguard.action.SHOW,
             android_vendor_thor2's patch 0009); ACCESS_KEYGUARD_SECURE_STORAGE is
             signature-only, so no other app can. -->
        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:permission="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE"
            android:launchMode="singleInstance"
            android:taskAffinity="io.github.ninetailsflip.lock.screen"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:directBootAware="true"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation">
            <intent-filter>
                <action android:name="org.thor2.keyguard.action.SHOW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LookActivity"
            android:exported="false"
            android:directBootAware="true" />

        <service
            android:name=".LockListener"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name="io.github.ninetailsflip.update.UpdateActivity"
            tools:node="remove" />
    </application>
</manifest>
